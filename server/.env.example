# KNITE Medico SaaS - Server Environment Configuration Template
# Copy this file to .env and fill in your actual production/development credentials.

# Server Configuration
PORT=5055
NODE_ENV=production

# Database Connection (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=knite_db
DB_USER=admin
DB_PASSWORD=Set_Your_Secure_DB_Password_Here

# Security & JWT Authentication
JWT_SECRET=Generate_A_Long_Random_64_Character_Secret_Key_Here
SUPERADMIN_KEY=Set_Your_SuperAdmin_Master_Key_Here

# Razorpay Payment Gateway (Live / Test)
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_KEY

# PhonePe Payment Gateway (Sandbox / Production)
PHONEPE_MERCHANT_ID=KNITEMEDICOUAT
PHONEPE_SALT_KEY=YOUR_PHONEPE_SALT_KEY
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=SANDBOX

# Google SMTP / Email Dispatch (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=kniteinfotech@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
SMTP_PASS=your-16-char-app-password

# Storage Path (1 TB HDD)
HDD_BACKUP_PATH=/data/backups
